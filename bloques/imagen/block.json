{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "dalila/imagen",
  "title": "Imagen del sitio",
  "category": "media",
  "icon": "format-image",
  "description": "Una imagen con la forma exacta que le da el diseño del sitio (marco, recorte, sombra). Se cambia con «Reemplazar» desde la biblioteca de medios.",
  "keywords": [ "imagen", "foto", "reemplazar" ],
  "textdomain": "dalila",
  "supports": { "html": false, "className": false, "customClassName": true },
  "attributes": {
    "url":           { "type": "string", "source": "attribute", "selector": "img", "attribute": "src" },
    "alt":           { "type": "string", "source": "attribute", "selector": "img", "attribute": "alt", "default": "" },
    "width":         { "type": "string", "source": "attribute", "selector": "img", "attribute": "width" },
    "height":        { "type": "string", "source": "attribute", "selector": "img", "attribute": "height" },
    "loading":       { "type": "string", "source": "attribute", "selector": "img", "attribute": "loading" },
    "fetchpriority": { "type": "string", "source": "attribute", "selector": "img", "attribute": "fetchpriority" }
  },
  "editorScript": "file:./editor.js"
}
