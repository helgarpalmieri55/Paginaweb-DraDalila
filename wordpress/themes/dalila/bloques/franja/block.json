{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "dalila/franja",
  "title": "Franja de mar",
  "category": "design",
  "icon": "format-image",
  "description": "La banda con la ballena, la tortuga y las olas que separa una sección de otra. Elige la escena y el color de la sección que viene debajo.",
  "keywords": [ "mar", "olas", "separador", "ballena" ],
  "textdomain": "dalila",
  "supports": { "html": false, "align": [ "full" ], "spacing": { "margin": false } },
  "attributes": {
    "escena": { "type": "number", "default": 0 },
    "desde":  { "type": "string", "default": "crema" },
    "hasta":  { "type": "string", "default": "agua" },
    "align":  { "type": "string", "default": "full" }
  },
  "editorScript": "file:./editor.js",
  "render": "file:./render.php"
}
